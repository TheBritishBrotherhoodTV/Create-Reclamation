#Create: Reclamation Server Configuration
[reclaimer]
	#Kinetic stress capacity consumed per RPM by the Mechanical Reclaimer.
	# Default: 8.0
	# Range: 0.0 ~ 1024.0
	stressImpact = 8.0
	#Chance (0.0 to 1.0) that a component is recovered intact during dismantling.
	#Failed rolls produce Salvaged Scrap.
	# Default: 0.85
	# Range: 0.0 ~ 1.0
	defaultSalvageRate = 0.85
	#Whether items without explicit reclaiming recipes can be dynamically deconstructed from crafting recipes.
	enableCraftingFallback = true
	#Minimum rotational speed (RPM) required for the Mechanical Reclaimer to operate.
	# Default: 16.0
	# Range: 0.0 ~ 256.0
	minOperatingSpeed = 16.0
